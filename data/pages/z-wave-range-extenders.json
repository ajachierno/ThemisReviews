  "buyers_guide": [
    {
      "q": "Do I need a range extender?",
      "a": "If devices far from your hub drop off or respond slowly, yes. Every plug-in Z-Wave or Zigbee device already repeats, but a dedicated extender is cheap and can sit exactly where the mesh is weak."
    },
    {
      "q": "Where should it go?",
      "a": "Halfway between the hub and the devices that drop out, on an outlet that's always powered."
    },
    {
      "q": "Does it work with any hub?",
      "a": "Z-Wave extenders work with any Z-Wave controller in your region. Zigbee repeaters work with most Zigbee hubs, but some only repeat for their own brand's devices."
    }
  ]
