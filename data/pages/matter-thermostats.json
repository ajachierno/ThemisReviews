  "buyers_guide": [
    {
      "q": "Do I need a C-wire?",
      "a": "Most smart thermostats need constant power from a C (common) wire. Some include a power adapter for homes without one, and a few run on batteries. Check your current thermostat's wiring before you buy."
    },
    {
      "q": "Will it work with my heating and cooling system?",
      "a": "Most smart thermostats handle standard 24 V forced-air and heat pump systems. Line-voltage electric baseboard heaters need a different, line-voltage thermostat. Check the maker's compatibility checker before buying."
    },
    {
      "q": "Do remote sensors matter?",
      "a": "If some rooms run hotter or colder than where the thermostat hangs, yes. Remote room sensors let the thermostat average temperatures or focus on the rooms you're using."
    }
  ]
