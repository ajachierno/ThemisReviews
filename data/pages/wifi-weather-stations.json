  "avoid": [],
  "buyers_guide": [
    {
      "q": "What does a Wi-Fi weather station do that an RF one doesn't?",
      "a": "It uploads readings to the internet, so you can see your backyard conditions from anywhere, get alerts, and share data with services like Weather Underground. Many also work with Home Assistant."
    },
    {
      "q": "Where should the outdoor sensor go?",
      "a": "In open air about five feet off the ground, away from walls, roofs, and pavement, which skew temperature. Wind and rain sensors need to be higher and clear of obstructions."
    },
    {
      "q": "Does it need a hub?",
      "a": "Most use an indoor display or small gateway that receives the outdoor sensor by radio and connects to Wi-Fi. It's included in the kit."
    }
  ]
}
