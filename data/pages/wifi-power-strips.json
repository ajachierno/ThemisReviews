  "buyers_guide": [
    {
      "q": "Smart power strip or several smart plugs?",
      "a": "A strip puts three to six individually controlled outlets, and usually USB ports, in one place, which suits a desk or entertainment center. Smart plugs suit single lamps spread around the house."
    },
    {
      "q": "Does a smart power strip protect against surges?",
      "a": "Only if the listing gives a joule rating. Many smart strips have surge protection, but some don't; check before plugging in a computer or TV."
    },
    {
      "q": "Can each outlet be controlled separately?",
      "a": "On most smart strips, yes: each outlet appears as its own switch in the app and in Alexa or Google. USB ports are usually switched together."
    }
  ]
}
