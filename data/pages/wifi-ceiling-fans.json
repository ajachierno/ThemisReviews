  "buyers_guide": [
    {
      "q": "Smart ceiling fan or a smart fan control?",
      "a": "A smart fan has Wi-Fi in the motor and light, so you get app control, schedules, and voice control without changing your wall switch. A smart wall control makes an existing fan smart without replacing it."
    },
    {
      "q": "Do smart ceiling fans need a hub?",
      "a": "Most connect over Wi-Fi to the maker's app and work with Alexa and Google. Some use Bluetooth for setup."
    },
    {
      "q": "What size fan do I need?",
      "a": "Roughly 42-48 inches for a bedroom up to 150 square feet, 52 inches for a typical living room, and 60 inches or more for large open rooms."
    }
  ]
