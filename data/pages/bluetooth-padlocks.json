  "buyers_guide": [
    {
      "q": "How does a Bluetooth padlock open?",
      "a": "With your phone over Bluetooth, a fingerprint on some models, or a backup code or key. You can share access with others through the app."
    },
    {
      "q": "Is it as strong as a regular padlock?",
      "a": "The shackle and body matter more than the electronics. Look for a hardened steel shackle and a weather rating for outdoor use."
    },
    {
      "q": "What if the battery dies?",
      "a": "Most warn you well before and charge over USB. Many also have a key or jump-start contacts as a backup."
    }
  ]
