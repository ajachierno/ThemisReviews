  "buyers_guide": [
    {
      "q": "What size dehumidifier do I need?",
      "a": "Capacity is measured in pints of water removed per day. Around 20-35 pints suits a bedroom or small basement; 50 pints suits a large damp basement. Bigger units also cover more square feet."
    },
    {
      "q": "Can it drain on its own?",
      "a": "Most have a hose port for continuous drainage into a floor drain, and some have a built-in pump to push water up into a sink. Otherwise you empty the bucket."
    },
    {
      "q": "What does the smart part add?",
      "a": "A full-bucket alert on your phone, a humidity target, schedules, and remote control, which matters most for a basement you don't visit every day."
    }
  ]
}
