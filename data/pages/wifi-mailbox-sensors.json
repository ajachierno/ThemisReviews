  "buyers_guide": [
    {
      "q": "How do mailbox sensors work?",
      "a": "A small sensor inside the mailbox detects the door opening or motion and sends an alert to your phone. Metal mailboxes block radio signals, so most use long-range radio with an indoor hub or receiver."
    },
    {
      "q": "Will it reach my house?",
      "a": "Check the stated range. Long-range models reach a quarter mile or more; Wi-Fi models need Wi-Fi coverage at the curb."
    },
    {
      "q": "Do they need a hub?",
      "a": "Most do. The hub plugs in indoors and passes alerts to the app."
    }
  ]
