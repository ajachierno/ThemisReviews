  "avoid": [],
  "buyers_guide": [
    {
      "q": "What can an IR blaster control?",
      "a": "Anything that uses an infrared remote: TVs, air conditioners, fans, fireplaces, soundbars, and older electronics. It needs a clear line of sight to the device."
    },
    {
      "q": "Will it know if my TV is on?",
      "a": "Usually not. IR is one-way, so the blaster sends a command but can't confirm the device received it. Some models add a sensor cable or power monitoring to guess the state."
    },
    {
      "q": "IR or RF?",
      "a": "IR covers most TVs and AC units. Some ceiling fans, shades, and outlets use radio (RF) remotes, which need a model with RF support."
    }
  ]
}
