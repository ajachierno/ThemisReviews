  "avoid": [],
  "buyers_guide": [
    {
      "q": "Permanent outdoor lights or string lights?",
      "a": "Permanent lights mount under the eaves or along the roofline and stay up all year, with colors you change for each holiday. String lights hang on patios and fences and come down when you want. Permanent kits cost more and take an afternoon to install."
    },
    {
      "q": "Are smart outdoor lights weatherproof?",
      "a": "Check the IP rating on the listing. IP65 handles rain and sprinklers; IP67 can survive brief submersion. The power adapter usually needs a covered outdoor outlet."
    },
    {
      "q": "Do they need a hub?",
      "a": "Most outdoor light kits connect over Wi-Fi with Bluetooth for setup, so no hub. Philips Hue outdoor lights need the Hue Bridge."
    }
  ]
