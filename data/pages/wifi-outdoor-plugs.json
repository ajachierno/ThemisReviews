  "avoid": [],
  "buyers_guide": [
    {
      "q": "What makes an outdoor smart plug different?",
      "a": "It's weatherproof (look for IP44 or better), usually has two or more outlets, and often a longer cord. Use it for holiday lights, pond pumps, and patio lights."
    },
    {
      "q": "Can I leave it out in the rain?",
      "a": "Rated plugs handle rain, but point the outlets down and keep them off the ground. Plug them into a GFCI-protected outdoor outlet with an in-use cover."
    },
    {
      "q": "Will it reach my Wi-Fi?",
      "a": "Outdoor outlets are often far from the router. If your phone has a weak signal where the plug goes, the plug will too. A mesh router or extender fixes that."
    }
  ]
