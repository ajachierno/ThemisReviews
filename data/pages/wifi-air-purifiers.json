  "buyers_guide": [
    {
      "q": "What size purifier do I need?",
      "a": "Match the room size to the purifier's rated coverage, ideally with some headroom. CADR (clean air delivery rate) is the better number to compare when listings give it."
    },
    {
      "q": "What does smart add?",
      "a": "App and voice control, schedules, filter reminders, and an air quality sensor that turns the fan up when the air gets worse. Matter models work with every major platform."
    },
    {
      "q": "How much do filters cost?",
      "a": "Replacement filters usually run $15 to $60 and last 6 to 12 months. Check the filter price before you buy the purifier."
    }
  ]
