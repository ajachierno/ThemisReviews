  "buyers_guide": [
    {
      "q": "Are smart space heaters safe?",
      "a": "Look for tip-over and overheat protection and a UL or ETL listing. Plug a heater straight into a wall outlet, never a power strip or a regular smart plug."
    },
    {
      "q": "Why not just use a smart plug?",
      "a": "Most heaters draw close to a plug's limit for hours, and many heater manuals forbid timers and smart plugs. A heater with Wi-Fi built in runs schedules and a thermostat safely."
    },
    {
      "q": "How much does a space heater cost to run?",
      "a": "A 1,500 W heater on high uses 1.5 kWh an hour, about 25 cents at the US average rate. Running it on a thermostat setting instead of full blast cuts that a lot."
    }
  ]
