  "buyers_guide": [
    {
      "q": "Portable or window AC?",
      "a": "Window units cool better for the money. Portable units suit windows that can't take a window unit, like casement or sliding windows, or rentals that don't allow them."
    },
    {
      "q": "Single hose or dual hose?",
      "a": "Dual-hose units pull outside air to cool the condenser, so they don't create negative pressure that draws warm air in through gaps. They cool large rooms faster."
    },
    {
      "q": "What does Wi-Fi add?",
      "a": "Cool the room before you get home, schedules, and Alexa or Google voice control."
    }
  ]
