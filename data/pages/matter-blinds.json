  "buyers_guide": [
    {
      "q": "Matter blinds: Wi-Fi or Thread?",
      "a": "Most Matter shades use Thread, which runs for months on a battery but needs a Thread border router (a HomePod mini, Apple TV, recent Nest Hub, or some Echo models). Wi-Fi shades need no border router but drain batteries faster."
    },
    {
      "q": "Retrofit motor or complete shade?",
      "a": "Complete shades come made to measure. Retrofit motors and tilt kits automate shades or blinds you already own."
    },
    {
      "q": "Will they work with my system?",
      "a": "Matter shades work with Apple Home, Google Home, Alexa, SmartThings, and Home Assistant."
    }
  ]
