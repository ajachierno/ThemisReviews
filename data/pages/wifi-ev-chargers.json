  "avoid": [],
  "buyers_guide": [
    {
      "q": "Plug-in or hardwired?",
      "a": "Plug-in chargers use a NEMA 14-50 outlet and can be moved. Hardwired chargers can deliver more current (48 A or more) and are required for some installs. Both need a 240 V circuit."
    },
    {
      "q": "How many amps do I need?",
      "a": "A 40 A charger adds about 30 miles of range per hour on most EVs, which covers overnight charging for nearly everyone. Your car's onboard charger may cap the speed anyway."
    },
    {
      "q": "What does smart add?",
      "a": "Scheduling for cheap off-peak electricity, charging history, and sometimes utility rebates. Check your utility for EV charger rebates before buying."
    }
  ]
}
