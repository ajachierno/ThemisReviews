  "buyers_guide": [
    {
      "q": "Cordless or corded pool robot?",
      "a": "Cordless robots skip the tangled cable and are easier to drop in, but run 1.5 to 3 hours per charge. Corded models run as long as you want and are usually cheaper for the same cleaning."
    },
    {
      "q": "Will it climb walls?",
      "a": "Check the listing. Floor-only models are cheaper; wall and waterline cleaning needs stronger motors and better navigation."
    },
    {
      "q": "What does the app add?",
      "a": "Cleaning modes and schedules, battery level, and on some models a map of where it cleaned. Most apps connect over Bluetooth or Wi-Fi when the robot is out of the water."
    }
  ]
