  "buyers_guide": [
    {
      "q": "How do propane tank monitors work?",
      "a": "Most stick to the bottom of the tank and measure the liquid level with ultrasound; others replace the gauge on large tanks. The app shows the level and alerts you before you run out."
    },
    {
      "q": "Bluetooth or Wi-Fi?",
      "a": "Bluetooth sensors only update when your phone is nearby. Wi-Fi models or a Wi-Fi bridge send alerts from anywhere."
    },
    {
      "q": "Will it fit my tank?",
      "a": "Check the tank sizes listed. Grill tanks (20 lb) and large home tanks usually need different models."
    }
  ]
