 "buyers_guide": [
  {
   "q": "Do I need an electrician?",
   "a": "Whole-home monitors clip current sensors around wires inside your electrical panel. Many people install them, but it means working inside a live panel. Hire an electrician if you're not comfortable."
  },
  {
   "q": "Whole-home or circuit-level?",
   "a": "Two main sensors show your total use. Adding circuit sensors shows which appliances use what, like the dryer, AC, or EV charger."
  },
  {
   "q": "Does it work with solar?",
   "a": "Many monitors can track solar production and net metering with extra sensors. Check the listing if you have panels."
  }
 ],
