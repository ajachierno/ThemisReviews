 "buyers_guide": [
  {
   "q": "Will a smart fan control work with my ceiling fan?",
   "a": "Wall fan controls work with fans that are switched from the wall and have a pull chain left on high. If your fan uses a handheld remote and a receiver in the canopy, you need a receiver-based controller instead."
  },
  {
   "q": "Can it also control the fan's light?",
   "a": "Some combo switches control both the fan and the light separately, which needs separate wires for the fan and light. Single-function controls only do the fan."
  },
  {
   "q": "Why not use a regular dimmer on a fan?",
   "a": "Dimmers aren't designed for fan motors and can make them hum or overheat. Use a control rated for fans."
  }
 ],
