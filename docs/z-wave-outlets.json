 "buyers_guide": [
  {
   "q": "In-wall outlet or plug-in smart plug?",
   "a": "An in-wall outlet replaces your receptacle, so nothing sticks out and both sockets stay usable. It needs wiring work. A plug-in smart plug needs no tools."
  },
  {
   "q": "Do I need a neutral wire?",
   "a": "Yes, nearly all smart outlets need line, neutral, and ground. Most outlet boxes have them."
  },
  {
   "q": "How long do the batteries last?",
   "a": "Most battery sensors on these lists are rated for one to three years, depending on how often they report. Low-power radios like Zigbee, Z-Wave, and Thread last much longer than Wi-Fi."
  }
 ],
