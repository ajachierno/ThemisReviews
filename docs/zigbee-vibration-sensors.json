 "buyers_guide": [
  {
   "q": "What can a vibration sensor detect?",
   "a": "Knocks, tilts, and drops: a washer or dryer finishing, a mailbox opening, a window being forced, or a door being knocked on."
  },
  {
   "q": "Can it tell me when the laundry is done?",
   "a": "Yes. Stick it on the washer or dryer and set an automation for when vibration stops for a few minutes."
  },
  {
   "q": "How long do the batteries last?",
   "a": "Most battery sensors on these lists are rated for one to three years, depending on how often they report. Low-power radios like Zigbee, Z-Wave, and Thread last much longer than Wi-Fi."
  }
 ],
