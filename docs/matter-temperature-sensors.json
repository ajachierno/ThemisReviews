 "buyers_guide": [
  {
   "q": "Why a Matter temperature sensor?",
   "a": "It reports to Apple Home, Google Home, Alexa, SmartThings, and Home Assistant at once, so you can trigger a fan, heater, or thermostat from any of them."
  },
  {
   "q": "Thread or Wi-Fi?",
   "a": "Thread sensors run for a year or more on a coin cell but need a Thread border router. Wi-Fi sensors use more power."
  },
  {
   "q": "How long do the batteries last?",
   "a": "Most battery sensors on these lists are rated for one to three years, depending on how often they report. Low-power radios like Zigbee, Z-Wave, and Thread last much longer than Wi-Fi."
  }
 ],
