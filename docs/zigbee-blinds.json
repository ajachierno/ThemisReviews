 "buyers_guide": [
  {
   "q": "Retrofit robot or new motorized shade?",
   "a": "Curtain robots and blind tilters attach to what you already have and install in minutes. Motorized shades replace your blinds and look cleaner, but you have to measure and order to size."
  },
  {
   "q": "How are they powered?",
   "a": "Most use a rechargeable battery charged over USB-C or a small solar panel. Expect weeks to months per charge depending on use."
  },
  {
   "q": "Do I need a hub?",
   "a": "Bluetooth robots need a hub for remote control and automations. Zigbee motors need a Zigbee hub. Wi-Fi models connect directly."
  }
 ],
