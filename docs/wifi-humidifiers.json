 "buyers_guide": [
  {
   "q": "What humidity should my home be?",
   "a": "Aim for 40 to 50 percent. Below 30 percent, skin, sinuses, and wood floors dry out; above 60 percent, mold and dust mites thrive. A smart humidifier holds a target level automatically."
  },
  {
   "q": "Warm mist or cool mist?",
   "a": "Cool mist uses less power and is safer around kids. Warm mist feels nicer in winter and boils the water, but uses more electricity. Some models do both."
  },
  {
   "q": "What does the smart part add?",
   "a": "Remote control, schedules, a humidity target, refill and filter alerts, and voice control through Alexa or Google."
  }
 ],
