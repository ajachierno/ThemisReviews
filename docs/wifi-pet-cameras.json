 "buyers_guide": [
  {
   "q": "Do I need a subscription?",
   "a": "Many pet cameras lock barking alerts, cloud video, and AI features behind a monthly plan. Check what the free tier includes; some Furbo listings require a plan just to activate."
  },
  {
   "q": "Treat tossing or just a camera?",
   "a": "Treat cameras let you reward your pet remotely. A regular pan-and-tilt indoor camera is much cheaper if you only want to watch and talk."
  },
  {
   "q": "Will it work on my Wi-Fi?",
   "a": "Most need 2.4 GHz Wi-Fi; some also support 5 GHz. Put the camera within good range of your router."
  }
