 "buyers_guide": [
  {
   "q": "What's an RF remote outlet?",
   "a": "A plug-in outlet switched by a small handheld radio remote, with no Wi-Fi, app, or hub. It's the simplest way to switch lamps, holiday lights, and hard-to-reach outlets."
  },
  {
   "q": "How far does the remote reach?",
   "a": "Usually 80-100 feet, and through walls, because 433 MHz radio passes through them better than Wi-Fi."
  },
  {
   "q": "Can I make them work with Alexa or Home Assistant?",
   "a": "Not directly. An RF bridge, such as the ones on our RF bridges page, can learn the remote's codes and add them to a smart home system."
  }
 ],
