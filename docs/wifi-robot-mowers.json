 "buyers_guide": [
  {
   "q": "Boundary wire or wire-free?",
   "a": "Older robots need a wire buried around the lawn edge. Newer wire-free models use RTK GPS, LiDAR, or cameras to map the lawn, which saves hours of setup."
  },
  {
   "q": "How big a lawn can it handle?",
   "a": "Check the rated area and the slope it can climb. Buy for your lawn size with some headroom."
  },
  {
   "q": "Is it safe around kids and pets?",
   "a": "Robot mowers have lift and obstacle sensors and stop the blades, but keep kids and pets off the lawn while it runs, and schedule it for times the yard is empty."
  }
