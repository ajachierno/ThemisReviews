 "buyers_guide": [
  {
   "q": "How accurate are body composition scales?",
   "a": "Weight is accurate to a few tenths of a pound. Body fat and muscle numbers from foot sensors are estimates; use them to see trends, not exact values."
  },
  {
   "q": "Wi-Fi or Bluetooth?",
   "a": "Wi-Fi scales sync on their own every time you step on. Bluetooth scales need your phone nearby with the app open."
  },
  {
   "q": "Does it work with Apple Health and Google Fit?",
   "a": "Most do, along with apps like Fitbit or MyFitnessPal. Check the listing for the ones you use."
  }
