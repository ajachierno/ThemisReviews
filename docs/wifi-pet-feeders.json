 "buyers_guide": [
  {
   "q": "Dry food only?",
   "a": "Almost all automatic feeders handle dry kibble only. Check the kibble size limits in the listing."
  },
  {
   "q": "What if the power or Wi-Fi goes out?",
   "a": "Look for battery backup. Most feeders keep their schedule locally and keep feeding without Wi-Fi; you just lose app control and alerts."
  },
  {
   "q": "Do I need the camera version?",
   "a": "A camera lets you watch your pet eat and confirms the food actually dropped. If you just want reliable meals, the non-camera version is cheaper."
  }
