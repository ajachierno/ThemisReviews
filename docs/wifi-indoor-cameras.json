 "buyers_guide": [
  {
   "q": "Do I need a subscription?",
   "a": "Many cameras store clips in the cloud only with a monthly plan. Others record to a microSD card or a base station for free. Check what the free tier includes before you buy several."
  },
  {
   "q": "Battery or wired?",
   "a": "Battery cameras go anywhere but sleep between events, so they can miss the first second of motion and need recharging. Wired cameras record continuously and react faster but need an outlet nearby."
  },
  {
   "q": "2.4 GHz or 5 GHz Wi-Fi?",
   "a": "Most cameras use 2.4 GHz, which reaches farther through walls. Some newer ones support 5 GHz for faster streaming close to the router."
  }
 ],
