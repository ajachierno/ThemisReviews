  "avoid": [
    {
      "asin": "B0CGMWH2XV",
      "brand": "Bkiyougo",
      "model": "10A wireless smart switch (2-pack)",
      "systems": [
        "alexa",
        "google-home",
        "smartthings",
        "home-assistant"
      ],
      "flag": "A bare relay module sold as a light switch, with contradictory ratings",
      "verdict": "It's listed as a Wi-Fi light switch, but it's a bare relay module meant to be wired into a circuit, and its own ratings don't agree with each other.",
      "reasons": [
        "The title says 10 A, the spec table says 16 A, and a bullet claims 3,500 W at 10 A max. At 120 V, 10 A is 1,200 W, so those figures can't all be true.",
        "It isn't a wall switch. It's a DIY module rated for 100 to 240 V that you hide in a box and wire yourself.",
        "The bullet meant to describe compatibility says it's \"Incompatible with any household appliances.\"",
        "The listing names no safety certification beyond FCC, which covers radio emissions, not electrical safety."
      ]
    }
